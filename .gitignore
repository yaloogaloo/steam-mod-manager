# Python environments, bytecode and tool caches
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.cache/
.VSCodeCounter/

# Coverage reports
.coverage
htmlcov/

# Machine-local settings, credentials and recovery receipt
config.local.json
settings.json
config/modio.json
/config/production_recovery.json

# Runtime data, backups, CAS and regenerable caches
data/
cache/
config/load_order/*.json
!config/load_order/.gitkeep

# Local Mod archive and logs; keep directory placeholders
mod/*
!mod/.gitkeep
*.log
logs/*
!logs/.gitkeep

# Sidecars, scratch databases and temporary development artifacts
.info/
.tmp_*
_tmp_*
# Canonical Agent workspace, including protected recovery (never commit credentials)
/_tmp/
*.db-wal
*.db-shm

# Generated audit and recovery outputs
tools/_audit_out/
tools/identity_recovery_rollback/
tools/_tmp_*
docs/*.json
/p0_*.json
/_phase*.json
/*_audit*.json
/*_pollution*.json
/*_forensic*.json
/*_probe*.json
/*_dump*.json

# Qt / PySide caches
*.qmlc
*.jsc
*_rc.py.bak

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
